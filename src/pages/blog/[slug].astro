---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Reveal from '../../components/ui/Reveal.astro';
import Subrayado from '../../components/ui/Subrayado.astro';
import { getPosts, getFeaturedImage, excerptTexto } from '../../lib/wp';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const crumbs = [
  { label: 'Blog', href: '/blog/' },
  { label: post.title.rendered, href: `/blog/${post.slug}/` },
];

const image = getFeaturedImage(post);
const descripcion = excerptTexto(post.excerpt) || post.title.rendered;

const formateador = new Intl.DateTimeFormat('es-PE', { day: 'numeric', month: 'long', year: 'numeric' });

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title.rendered,
  description: descripcion,
  datePublished: post.date,
  ...(image && { image: image.source_url }),
  author: { '@type': 'Organization', name: 'Peruanita E.I.R.L.' },
  publisher: { '@type': 'Organization', name: 'Peruanita E.I.R.L.' },
};
---

<BaseLayout
  title={post.title.rendered}
  description={descripcion}
  ogImage={image?.source_url}
  breadcrumbs={crumbs}
>
  <script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <SiteHeader slot="header" />

  <div class="border-b border-border bg-crema-50">
    <div class="mx-auto max-w-3xl px-6 py-6">
      <Breadcrumb items={crumbs} />
    </div>
  </div>

  <article class="mx-auto max-w-3xl px-6 py-14 md:py-20">
    <Reveal>
      <p class="text-xs uppercase tracking-wider text-muted-foreground/70">
        {formateador.format(new Date(post.date))}
      </p>
      <h1 class="mt-3 font-display text-3xl leading-tight text-foreground md:text-4xl">
        <Subrayado color="#F28B82">{post.title.rendered}</Subrayado>
      </h1>
    </Reveal>

    {image && (
      <Reveal delay={80}>
        <img
          src={image.source_url}
          alt={image.alt_text}
          width={image.media_details?.width}
          height={image.media_details?.height}
          loading="eager"
          fetchpriority="high"
          class="mt-8 h-auto w-full object-cover"
        />
      </Reveal>
    )}

    <Reveal delay={140} class="mt-10">
      <div class="prose" set:html={post.content.rendered} />
    </Reveal>
  </article>

  <SiteFooter slot="footer" />
</BaseLayout>
