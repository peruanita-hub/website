---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<BaseLayout title="Página no encontrada" description="La página que buscas no existe o fue movida." noindex>
  <SiteHeader slot="header" />

  <section class="mx-auto max-w-xl px-6 py-24 text-center">
    <p class="font-display font-bold text-6xl text-rojo-500">404</p>
    <h1 class="mt-4 font-display font-bold text-2xl text-tinta-900">No encontramos esta página</h1>
    <p class="mt-2 text-tinta-700">
      Puede que el enlace esté roto o la página se haya movido.
    </p>
    <a
      href="/"
      class="mt-8 inline-block rounded bg-rojo-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-rojo-700"
    >
      Volver al inicio
    </a>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>
