---
import { cn } from '../../lib/utils';

interface Props {
  for: string;
  required?: boolean;
  class?: string;
}

const { for: htmlFor, required = false, class: className } = Astro.props;
---

<label for={htmlFor} class={cn('block text-sm font-medium text-foreground', className)}>
  <slot />
  {required && (
    <>
      <span aria-hidden="true" class="text-destructive">*</span>
      <span class="sr-only">(obligatorio)</span>
    </>
  )}
</label>
