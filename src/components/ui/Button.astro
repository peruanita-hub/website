---
import { cn } from '../../lib/utils';

/**
 * Botón con el sistema de variantes de shadcn/ui, en Astro puro.
 * Renderiza <a> si recibe href y <button> si no — un enlace disfrazado
 * de botón rompe la navegación con teclado y el menú contextual.
 */
interface Props {
  variant?: 'default' | 'secondary' | 'outline' | 'ghost' | 'link' | 'onDark';
  size?: 'sm' | 'default' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'default',
  size = 'default',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 whitespace-nowrap font-bold transition-colors ' +
  'disabled:pointer-events-none disabled:opacity-50 rounded-md';

const variants = {
  default: 'bg-primary text-primary-foreground hover:bg-rojo-700',
  secondary: 'bg-secondary text-secondary-foreground hover:bg-crema-200/70',
  outline: 'border-2 border-primary text-primary hover:bg-rojo-50',
  ghost: 'text-foreground hover:bg-muted',
  link: 'text-primary underline-offset-4 hover:underline',
  // Sobre fondo rojo o fotografía oscura: el rojo de marca no contrasta.
  onDark: 'border-2 border-white text-white hover:bg-white hover:text-primary',
};

const sizes = {
  sm: 'h-9 px-4 text-sm',
  default: 'h-11 px-6 text-sm',
  lg: 'h-12 px-8 text-base',
};

const classes = cn(base, variants[variant], sizes[size], className);
const Tag = href ? 'a' : 'button';
---

<Tag class={classes} href={href} type={href ? undefined : type} {...rest}>
  <slot />
</Tag>
